# Google Chat Space Incoming Webhook URL
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/YOUR_SPACE/messages?key=YOUR_KEY&token=YOUR_TOKEN

# Alert Cooldown Period in Seconds (Default: 900 = 15 minutes)
ALERT_COOLDOWN_SECONDS=900

# Number of log lines to include in the alert
MAX_LOG_LINES=15
